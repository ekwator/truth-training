#!/bin/bash
set -e

# Check if systemctl --user is available
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user --version >/dev/null 2>&1; then
    echo "WARNING: systemd user services are not supported on this system."
    echo "The truth-core-server binary has been installed but the service will not start automatically."
    exit 0
fi

# Get the installing user's home directory
INSTALL_USER="${SUDO_USER:-$USER}"
if [ "$INSTALL_USER" = "root" ]; then
    INSTALL_USER=$(logname 2>/dev/null || echo "$USER")
fi

USER_HOME=$(getent passwd "$INSTALL_USER" | cut -d: -f6)
if [ -z "$USER_HOME" ]; then
    USER_HOME="$HOME"
fi

# Create user systemd directory if it doesn't exist
SYSTEMD_USER_DIR="$USER_HOME/.config/systemd/user"
mkdir -p "$SYSTEMD_USER_DIR"

# Install service file to user directory
if [ -f /usr/lib/truth-core-server/truth-core-server.service ]; then
    cp /usr/lib/truth-core-server/truth-core-server.service "$SYSTEMD_USER_DIR/truth-core-server.service"
    chmod 644 "$SYSTEMD_USER_DIR/truth-core-server.service"
    
    # Reload systemd user daemon
    systemctl --user daemon-reload || true
    
    # Enable and start the service
    systemctl --user enable truth-core-server.service || true
    systemctl --user start truth-core-server.service || true
    
    echo "truth-core-server service has been installed and started for user $INSTALL_USER"
else
    echo "ERROR: Service file not found at /usr/lib/truth-core-server/truth-core-server.service"
    exit 1
fi

exit 0
